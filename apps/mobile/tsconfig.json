{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "paths": {
      "@hooks/*": [
        "src/hooks/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@views/*": [
        "src/views/*"
      ],
      "@locales/*": [
        "src/locales/*"
      ],
      "@navigation": [
        "src/navigation/index.tsx"
      ],
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src",
    "index.ts",
    "app.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo",
    "android",
    "ios",
    "test",
    "scripts",
    "metro.config.js",
    "babel.config.js"
  ]
}
