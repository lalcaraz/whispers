# Read by app.config.js at build time. Copy to `.env` and fill in.

# EAS project id - required for push notifications. Create a project with
# `eas init` (or find it in the Expo dashboard) and paste the UUID here.
EAS_PROJECT_ID=

# iOS bundle identifier / Android package name. Use your own reverse-domain id;
# it must match the one in your Firebase config files (see below).
PACKAGE_NAME=com.example.whispers
