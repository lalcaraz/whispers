{
  "name": "@whispers/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build-eas-prod-android": "eas build --platform android",
    "build-eas-prod-ios": "eas build --platform ios",
    "build-local-android-release": "cd android && ./gradlew clean && ./gradlew assembleRelease && adb uninstall com.lalcaraz.whispers && adb install app/build/outputs/apk/release/app-release.apk && cd ..",
    "build-local-android-debug": "cd android && ./gradlew clean && ./gradlew assembleDebug && adb uninstall com.lalcaraz.whispers && adb install app/build/outputs/apk/debug/app-debug.apk && cd ..",
    "proxy-server": "node scripts/proxy-server.js",
    "list-android-devices": "adb devices",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/ed25519": "3.0.0",
    "@react-native-firebase/app": "^26.0.0",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@whispers/protocol": "*",
    "axios": "^1.13.4",
    "expo": "^57.0.0",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-sensors": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "6.3.23",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
