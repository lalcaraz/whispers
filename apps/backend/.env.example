# --- Server ---
PORT=3000
NODE_ENV=development            # set to "production" for real deployments

# --- Database ---
DB_PATH=./data/whispers.db

# --- Security ---
# Max age (ms) of a signed request's timestamp. Requests older than this are
# rejected. Also bounds how long replay records are kept.
TIMESTAMP_TOLERANCE=300000

# Number of reverse proxies in front of this service (sets Express "trust proxy").
# Required in production. Count the hops that append to X-Forwarded-For:
#   direct exposure ............ 0
#   one nginx / Caddy .......... 1
#   Cloudflare -> nginx ........ 2
# Setting this too high lets clients spoof their IP and bypass rate limiting.
TRUST_PROXY_HOPS=1

# Secret for POST /cleanup. In production the server refuses to start unless this
# is set to a random value of at least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CLEANUP_KEY=

# --- Push delivery ---
# When "true", /send validates and records the request but does not contact Expo.
# Used by `npm run smoke`; leave unset in production.
PUSH_DRY_RUN=
